#include "MyVector.h"

template<typename T>
using Vector = MyVector<T>;

template<typename K, typename V>
struct HashNode
{
    K key;
    V value;
    HashNode* next = nullptr;

    HashNode(const K& k, const V& v, HashNode* p): key(k), value(v), next(p) {};
};

template<typename K, typename V>
class MyUnorderedMap {
public:
    HashNode<K, V>* find(const K&) noexcept;
    void insert(const K&, const V&);
    void erase(const K&) noexcept;

    MyUnorderedMap() : buckets(nullptr), num_elements(0) {};
    ~MyUnorderedMap();

private:
    size_t get_bucket_index(const K& key) {
        size_t hash_val = std::hash<K>{}(key); // std::hash是什么用法?
        return hash_val % buckets.size();
    }

    Vector<HashNode<K, V>*> buckets;    // node是使用外部insert的node还是copy一份？外部的内存不受控制，内存被释放了怎么办？
    size_t num_elements;                // 元素（节点）总数？
};

template<typename K, typename V>
HashNode<K, V>* MyUnorderedMap<K, V>::find(const K& key) noexcept {
    size_t hash_val = get_bucket_index(key);

    HashNode<K, V> *resNode = buckets[hash_val];
    while (resNode && resNode->key != key) {
        resNode = resNode->next;
    }
    return resNode;
}

template<typename K, typename V>
void MyUnorderedMap<K, V>::insert(const K& key, const V& value) {
    size_t hash_val = get_bucket_index(key);

    // 链表头插法
    buckets[hash_val] = new HashNode<K, V>(key, value, buckets[hash_val]);  // struct HashNode 需要定义构造函数么？默认是什么？
}

template<typename K, typename V>
void MyUnorderedMap<K, V>::erase(const K& key) noexcept {
    size_t hash_val = get_bucket_index(key);

    // 删除指定链表节点
    HashNode<K, V> dummyNode;
    dummyNode.next = buckets[hash_val];

    HashNode<K, V> *pre = &dummyNode;
    HashNode<K, V> *curr = &dummyNode.next;

    while (curr) {
        if (curr->key == key)
        {
            pre->next = curr->next;
            delete curr;
            break;
        }

        pre = curr;
        curr = curr->next;
    }
    
    buckets[hash_val] = dummyNode.next;
}

template<typename K, typename V>
MyUnorderedMap<K, V>::~MyUnorderedMap() {
    for (size_t i = 0; i < count; i++)
    {
        HashNode<K, V>* curNode = buckets[i];
        while (curNode)
        {
            HashNode<K, V>* nxt = curNode->next;
            delete curNode;
            curNode = nxt;
        }
    }
    num_elements = 0;
}