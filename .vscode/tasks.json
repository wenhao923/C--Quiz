{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file with SFML & ImGui",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",

                // --- 1. 头文件搜索路径 ---
                "/I${workspaceFolder}\\thirdParty\\SFML\\include",
                "/I${workspaceFolder}\\thirdParty\\imgui",
                "/I${workspaceFolder}\\thirdParty\\imgui-sfml",
                "/I${workspaceFolder}",

                // --- 2. 编译产物输出路径 ---
                "/Fo${fileDirname}\\build\\obj\\", 
                "/Fd${fileDirname}\\build\\", 
                "/Fe${fileDirname}\\build\\main.exe",
                
                // --- 3. 要编译的源文件 (必须放在 /link 之前！！！) ---
                "${fileDirname}\\main.cpp",
                "${workspaceFolder}\\thirdParty\\imgui\\imgui.cpp",
                "${workspaceFolder}\\thirdParty\\imgui\\imgui_draw.cpp",
                "${workspaceFolder}\\thirdParty\\imgui\\imgui_tables.cpp",
                "${workspaceFolder}\\thirdParty\\imgui\\imgui_widgets.cpp",
                "${workspaceFolder}\\thirdParty\\imgui-sfml\\imgui-SFML.cpp",

                // --- 4. 链接器指令 (分水岭，后面的全归链接器管) ---
                "/link", 
                "/LIBPATH:${workspaceFolder}\\thirdParty\\SFML\\lib",
                "sfml-graphics.lib",
                "sfml-window.lib",
                "sfml-system.lib",
                "opengl32.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger with SFML linking."
        }
    ],
    "version": "2.0.0"
}