{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project (Windows MSVC)",
            "type": "cppbuild",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/utf-8",
                "/wd4819",
                // include目录
                "/I${workspaceFolder}/thirdParty/SFML/windows-x64/include",
                "/I${workspaceFolder}/thirdParty/imgui",
                "/I${workspaceFolder}/thirdParty/imgui-sfml",
                "/I${workspaceFolder}/core",

                // 源码待编译
                "${workspaceFolder}/projects/${input:projectName}/main.cpp",
                "${workspaceFolder}/core/MyThreadPool.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui_draw.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui_tables.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui_widgets.cpp",
                "${workspaceFolder}/thirdParty/imgui-sfml/imgui-SFML.cpp",

                // 输出
                "/Fo${workspaceFolder}/build/${input:projectName}/", 
                "/Fd${workspaceFolder}/build/${input:projectName}/", 
                "/Fe${workspaceFolder}/build/${input:projectName}/${input:projectName}.exe",

                // 静态链接
                "/link",
                "/LIBPATH:${workspaceFolder}/thirdParty/SFML/windows-x64/lib",
                "sfml-graphics.lib",
                "sfml-window.lib",
                "sfml-system.lib",
                "opengl32.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "Windows 下专用的 MSVC 编译任务"
        },
        {
            "label": "Build Project (macOS ARM64)",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wno-deprecated-declarations",
                // include目录
                "-I${workspaceFolder}/thirdParty/SFML/macos-arm64/include",
                "-I${workspaceFolder}/thirdParty/imgui",
                "-I${workspaceFolder}/thirdParty/imgui-sfml",
                "-I${workspaceFolder}/core",

                // 源码待编译
                "${workspaceFolder}/projects/${input:projectName}/main.cpp",
                "${workspaceFolder}/core/MyThreadPool.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui_draw.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui_tables.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui_widgets.cpp",
                "${workspaceFolder}/thirdParty/imgui-sfml/imgui-SFML.cpp",

                // 链接
                "-L${workspaceFolder}/thirdParty/SFML/macos-arm64/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-framework",
                "OpenGL",
                "-Wl,-rpath,${workspaceFolder}/thirdParty/SFML/macos-arm64/lib",
                "-o",
                "${workspaceFolder}/build/${input:projectName}/${input:projectName}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Mac 下专用的 Clang 编译任务"
        }
    ],
    "inputs": [
        {
            "id": "projectName",         // 变量名，一会我们在上面用 ${input:projectName} 召唤它
            "type": "pickString",        // 类型：下拉菜单选项 (让你不用手动敲键盘)
            "description": "请选择今天要跑哪个项目？", 
            "options": [
                "Boids",                 // 你的鱼群项目
                "FutureGame",            // 未来的新项目
                "OtherQuiz"              // 平时的测试沙盒
            ],
            "default": "Boids"           // 默认选中鱼群
        }
    ]
}