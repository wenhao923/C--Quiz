{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project (Windows MSVC)",
            "type": "cppbuild",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/utf-8",
                "/wd4819",
                // include目录
                "/I${workspaceFolder}/thirdParty/SFML/windows-x64/include",
                "/I${workspaceFolder}/thirdParty/imgui",
                "/I${workspaceFolder}/thirdParty/imgui-sfml",
                "/I${workspaceFolder}/core",

                // 源码待编译
                "${workspaceFolder}/projects/${config:project.run.selectedProject}/main.cpp",
                "${workspaceFolder}/core/MyThreadPool.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui_draw.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui_tables.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui_widgets.cpp",
                "${workspaceFolder}/thirdParty/imgui-sfml/imgui-SFML.cpp",

                // 输出
                "/Fo${workspaceFolder}/build/${config:project.run.selectedProject}/", 
                "/Fd${workspaceFolder}/build/${config:project.run.selectedProject}/", 
                "/Fe${workspaceFolder}/build/${config:project.run.selectedProject}/${config:project.run.selectedProject}.exe",

                // 静态链接
                "/link",
                "/LIBPATH:${workspaceFolder}/thirdParty/SFML/windows-x64/lib",
                "sfml-graphics.lib",
                "sfml-window.lib",
                "sfml-system.lib",
                "opengl32.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "Windows 下专用的 MSVC 编译任务"
        },
        {
            "label": "Build Project (macOS ARM64)",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wno-deprecated-declarations",
                // include目录
                "-I${workspaceFolder}/thirdParty/SFML/macos-arm64/include",
                "-I${workspaceFolder}/thirdParty/imgui",
                "-I${workspaceFolder}/thirdParty/imgui-sfml",
                "-I${workspaceFolder}/core",

                // 源码待编译
                "${workspaceFolder}/projects/${config:project.run.selectedProject}/main.cpp",
                "${workspaceFolder}/core/MyThreadPool.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui_draw.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui_tables.cpp",
                "${workspaceFolder}/thirdParty/imgui/imgui_widgets.cpp",
                "${workspaceFolder}/thirdParty/imgui-sfml/imgui-SFML.cpp",

                // 链接
                "-L${workspaceFolder}/thirdParty/SFML/macos-arm64/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-framework",
                "OpenGL",
                "-Wl,-rpath,${workspaceFolder}/thirdParty/SFML/macos-arm64/lib",
                "-o",
                "${workspaceFolder}/build/${config:project.run.selectedProject}/${config:project.run.selectedProject}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Mac 下专用的 Clang 编译任务"
        }
    ]
}