{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build (Cross-Platform)",
            "command": "echo",
            "args": [
                "Start building..."
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Cross-platform build for SFML + ImGui",
            "windows": {
                "command": "cl.exe",
                "args": [
                    "/Zi",
                    "/EHsc",
                    "/nologo",
                    "/utf-8",
                    "/I${workspaceFolder}/thirdParty/SFML/windows-x64/include",
                    "/I${workspaceFolder}/thirdParty/imgui",
                    "/I${workspaceFolder}/thirdParty/imgui-sfml",
                    "/I${workspaceFolder}",
                    "/I${fileDirname}",
                    "/Fo${workspaceFolder}/build/",
                    "/Fd${workspaceFolder}/build/",
                    "/Fe${fileDirname}/build/main.exe",
                    "${fileDirname}/main.cpp",
                    "${workspaceFolder}/thirdParty/imgui/imgui.cpp",
                    "${workspaceFolder}/thirdParty/imgui/imgui_draw.cpp",
                    "${workspaceFolder}/thirdParty/imgui/imgui_tables.cpp",
                    "${workspaceFolder}/thirdParty/imgui/imgui_widgets.cpp",
                    "${workspaceFolder}/thirdParty/imgui-sfml/imgui-SFML.cpp",
                    "/link",
                    "/LIBPATH:${workspaceFolder}/thirdParty/SFML/windows-x64/lib",
                    "sfml-graphics.lib",
                    "sfml-window.lib",
                    "sfml-system.lib",
                    "opengl32.lib"
                ],
                "problemMatcher": [
                    "$msCompile"
                ]
            },
            "osx": {
                "command": "clang++",
                "args": [
                    "-g",
                    "-std=c++17",
                    "-Wall",
                    "-Wno-deprecated-declarations",
                    "-I${workspaceFolder}/thirdParty/SFML/macos-arm64/include",
                    "-I${workspaceFolder}/thirdParty/imgui",
                    "-I${workspaceFolder}/thirdParty/imgui-sfml",
                    "-I${workspaceFolder}",
                    "-I${fileDirname}",
                    "${fileDirname}/main.cpp",
                    "${workspaceFolder}/thirdParty/imgui/imgui.cpp",
                    "${workspaceFolder}/thirdParty/imgui/imgui_draw.cpp",
                    "${workspaceFolder}/thirdParty/imgui/imgui_tables.cpp",
                    "${workspaceFolder}/thirdParty/imgui/imgui_widgets.cpp",
                    "${workspaceFolder}/thirdParty/imgui-sfml/imgui-SFML.cpp",
                    "-L${workspaceFolder}/thirdParty/SFML/macos-arm64/lib",
                    "-lsfml-graphics",
                    "-lsfml-window",
                    "-lsfml-system",
                    "-framework",
                    "OpenGL",
                    "-Wl,-rpath,${workspaceFolder}/thirdParty/SFML/macos-arm64/lib",
                    "-o",
                    "${fileDirname}/build/main"
                ],
                "problemMatcher": [
                    "$gcc"
                ]
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ 生成活动文件",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}