{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                // 1. 指定 .obj 文件的输出目录 (注意末尾的反斜杠)
                "/Fo${workspaceFolder}\\build\\obj\\", 

                // 2. 指定编译器产生的临时 .pdb 文件的目录
                "/Fd${workspaceFolder}\\build\\debug", 

                // 3. 指定最终的 .exe 输出路径 (链接器会顺便把最终的 .pdb 和 .ilk 也放在这旁边)
                "/Fe${workspaceFolder}\\build\\test_pool.exe",


                "${workspaceFolder}\\main.cpp", 
                "${workspaceFolder}\\MyThreadPool.cpp",
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}