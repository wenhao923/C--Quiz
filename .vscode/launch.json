{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (Windows MSVC)",
            "type": "cppvsdbg", 
            "request": "launch",
            "program": "${workspaceFolder}/build/${config:project.run.selectedProject}/${config:project.run.selectedProject}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}/thirdParty/SFML/windows-x64/bin;${env:PATH}"
                }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "Build Project (Windows MSVC)"
        },

        // ==========================================
        // 🍎 2. macOS ARM64 专属调试通道
        // ==========================================
        {
            "name": "Debug (macOS ARM64)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${config:project.run.selectedProject}/${config:project.run.selectedProject}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "MIMode": "lldb",
            "externalConsole": false,
            "preLaunchTask": "Build Project (macOS ARM64)" 
        }
    ]
}