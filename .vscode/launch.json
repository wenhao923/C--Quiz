{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (Windows MSVC)",
            "type": "cppvsdbg", 
            "request": "launch",
            "program": "${workspaceFolder}/build/${input:projectName}/${input:projectName}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}/thirdParty/SFML/windows-x64/bin;${env:PATH}"
                }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "Build Project (Windows MSVC)"
        },

        // ==========================================
        // 🍎 2. macOS ARM64 专属调试通道
        // ==========================================
        {
            "name": "Debug (macOS ARM64)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${input:projectName}/${input:projectName}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "MIMode": "lldb",
            "externalConsole": false,
            "preLaunchTask": "Build Project (macOS ARM64)" 
        }
    ],
    "inputs": [
        {
            "id": "projectName",         
            "type": "pickString",        
            "description": "请选择今天要跑哪个项目？", 
            "options": [
                "Boids",                 
                "FutureGame",            
                "OtherQuiz"              
            ],
            "default": "Boids"           
        }
    ]
}