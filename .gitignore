# =======================================
# C++ / CMake 工业级 Git 忽略清单
# =======================================

# 1. 忽略所有 CMake 的生成的构建目录
build/
out/
.cmake/
CMakeCache.txt
CMakeFiles/

# 2. 忽略所有最终的编译产物 (你的 bin 和 lib 文件夹)
bin/
lib/
*.exe
*.dll
*.so
*.dylib
*.lib
*.a
*.pdb    # 极其庞大的调试符号文件，绝不能传

# 3. 忽略 VS Code 的本地私人配置 (部分)
.vscode/
!.vscode/settings.json   # (可选) 允许上传公共设置，比如我们加的防乱码设置
!.vscode/launch.json     # (可选) 允许上传调试配置

# 4. 忽略 Visual Studio 的临时文件
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
.vs/

# 5. 忽略系统的缓存文件
.DS_Store
Thumbs.db